# Enables the naive and bonjour recommenders in npm run eval, the MCP server and the run API.
ANTHROPIC_API_KEY=
BONJOUR_MODEL=claude-haiku-4-5-20251001
# Only for an API key not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
# Required anywhere but `next dev` for the run API. Send it as the x-demo-token header.
DEMO_ACCESS_TOKEN=
